# === Copy to .env and fill in. NEVER commit .env ===

# Retell AI → Settings → API Keys (the SECRET key, not the public key)
RETELL_API_KEY=

# Your agent id — printed by scripts/create_prompt_agent.py
AGENT_ID=

# A number you own in E.164 format (Retell dashboard → Phone Numbers)
# NOTE: Retell-provided numbers can only dial US destinations.
FROM_NUMBER=

# Optional: ElevenLabs (Starter plan) for offline script→audio
ELEVENLABS_API_KEY=
EL_VOICE_ID=

# Optional overrides
# EL_TTS_MODEL=eleven_v3          # default: eleven_flash_v2_5
# EL_STABILITY=0.35
# EL_STYLE=0.45
# EL_SIMILARITY=0.85
# RETELL_VOICE_ID=               # set by scripts/clone_voice.py output
# RETELL_AGENT_NAME=My Assistant
